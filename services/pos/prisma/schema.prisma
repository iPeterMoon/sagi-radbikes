generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model products {
  id               BigInt             @id @default(autoincrement())
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  name             String?
  price            Float?             @db.Real
  stock            Int?
  description      String?
  min_stock        Int?
  SKU              String             @unique
  barcode_upc      String?
  is_active        Boolean            @default(true)
  subcategory_id   BigInt?
  brand_id         BigInt?
  product_images   product_images[]
  subcategory      subcategory?       @relation(fields: [subcategory_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale_details     sale_details[]
}

model product_images {
  id            BigInt   @id @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  image_url     String?
  product_id    BigInt
  is_main_image Boolean?
  products      products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model subcategory {
  id          BigInt     @id @default(autoincrement())
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  name        String?
  category_id BigInt?
  products    products[]
}

model sales {
  id             BigInt         @id @default(autoincrement())
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  sold_at        DateTime?      @default(now()) @db.Timestamp(6)
  total          Float?
  user_seller    BigInt?
  folio          String?
  subtotal       Float?
  IVA_amount     Float?
  tax_percentage Float?
  payments       payments[]
  sale_details   sale_details[]
  users          users?         @relation(fields: [user_seller], references: [id])
}

model sale_details {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  quantity   Int?      @default(1)
  unitPrice  Float?    @db.Real
  sale_id    BigInt?
  product_id BigInt?
  products   products? @relation(fields: [product_id], references: [id], onDelete: Restrict)
  sales      sales?    @relation(fields: [sale_id], references: [id], onDelete: Cascade)
}

model payments {
  id            BigInt   @id(map: "payment_pkey") @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  paymentMethod String?
  amount        Float?
  sale_id       BigInt?
  sales         sales?   @relation(fields: [sale_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_sale_id_fkey")
}

model users {
  id         BigInt   @id(map: "Users_pkey") @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  username   String?  @unique @db.VarChar
  password   String?  @db.VarChar
  sales      sales[]
}
