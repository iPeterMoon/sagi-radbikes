generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brands {
  id         BigInt     @id(map: "Brand_pkey") @default(autoincrement())
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  name       String?
  products   products[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id          BigInt        @id @default(autoincrement())
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  name        String?       @db.VarChar
  description String?       @db.VarChar
  subcategory subcategory[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payments {
  id            BigInt   @id(map: "payment_pkey") @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  paymentMethod String?
  amount        Float?
  sale_id       BigInt?
  sales         sales?   @relation(fields: [sale_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_sale_id_fkey")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_images {
  id               BigInt            @id @default(autoincrement())
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  image_url        String?
  product_id       BigInt
  /// Si es NULL, es una imagen general del producto (fallback para todas las variantes).
  /// Si tiene valor, es específica de esa variante.
  variant_id       BigInt?
  is_main_image    Boolean?
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([variant_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_physical {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  name       String?
  value      String?
  product_id BigInt?
  products   products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id               BigInt             @id @default(autoincrement())
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  name             String?
  /// Precio de referencia/plantilla. Ya NO es el precio de venta autoritativo —
  /// solo se usa para pre-llenar el campo `price` al crear una variante nueva.
  price            Float?             @db.Real
  /// Costo de referencia/plantilla, mismo rol que `price` arriba.
  cost             Float?             @db.Real
  description      String?
  /// Stock mínimo de referencia/plantilla, mismo rol que `price` arriba.
  min_stock        Int?
  is_active        Boolean            @default(true)
  subcategory_id   BigInt?
  brand_id         BigInt?
  product_images   product_images[]
  product_physical product_physical[]
  product_variants product_variants[]
  brands           brands?            @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_metadata_brand_id_fkey")
  subcategory      subcategory?       @relation(fields: [subcategory_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_metadata_subcategory_id_fkey")
}

/// Variante vendible de un producto (ej. color, talla). Contiene el SKU, código de
/// barras, precio y stock autoritativos — el producto padre solo guarda valores de referencia.
model product_variants {
  id          BigInt   @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  product_id  BigInt
  SKU         String   @unique
  barcode_upc String?
  price       Float?   @db.Real
  /// Costo de compra autoritativo de esta variante, usado para calcular márgenes.
  cost        Float?   @db.Real
  stock       Int?
  min_stock   Int?
  is_active   Boolean  @default(true)

  products                   products                     @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variant_attributes product_variant_attributes[]
  product_images             product_images[]
  sale_details               sale_details[]

  @@index([product_id])
}

/// Par atributo/valor de una variante (ej. name="Color", value="Rojo"). Mismo patrón
/// EAV que product_physical, pero a nivel de variante en vez de producto.
model product_variant_attributes {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String?
  value      String?
  variant_id BigInt

  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([variant_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  id          BigInt      @id @default(autoincrement())
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  name        String
  description String?
  user_role   user_role[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sale_details {
  id               BigInt            @id @default(autoincrement())
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  quantity         Int?              @default(1)
  unitPrice        Float?            @db.Real
  /// Costo unitario de la variante al momento de la venta (snapshot para que el
  /// margen de ventas pasadas no cambie si el costo del producto cambia después).
  unitCost         Float?            @db.Real
  sale_id          BigInt?
  variant_id       BigInt?
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  sales            sales?            @relation(fields: [sale_id], references: [id], onDelete: Cascade)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sales {
  id             BigInt         @id @default(autoincrement())
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  sold_at        DateTime?      @default(now()) @db.Timestamp(6)
  total          Float?
  user_seller    BigInt?
  folio          String?
  subtotal       Float?
  IVA_amount     Float?
  tax_percentage Float?
  payments       payments[]
  sale_details   sale_details[]
  users          users?         @relation(fields: [user_seller], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model subcategory {
  id          BigInt      @id @default(autoincrement())
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  name        String?
  category_id BigInt?
  products    products[]
  categories  categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_role {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  role_id    BigInt?
  user_id    BigInt
  roles      roles?   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         BigInt      @id(map: "Users_pkey") @default(autoincrement())
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  username   String?     @unique @db.VarChar
  password   String?     @db.VarChar
  nombre     String?     @db.VarChar
  apellido   String?     @db.VarChar
  email      String?     @db.VarChar
  telefono   String?     @unique @db.VarChar
  is_active  Boolean     @default(true)
  sales      sales[]
  user_role  user_role[]
}

/// Configuración general del sistema (fila única/singleton).
model store_settings {
  id               BigInt   @id @default(autoincrement())
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  /// Multiplicador sobre el costo para sugerir un precio de venta (ej. 1.5 = 50% de margen).
  suggested_margin Float    @default(1.5)
}
